services:
  db:
    image: postgres:15-alpine
    container_name: mdis_crm_db
    environment:
      POSTGRES_USER: crm_user
      POSTGRES_PASSWORD: crm_password
      POSTGRES_DB: mdis_crm
    ports:
      - "5434:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
      - ./migrations:/docker-entrypoint-initdb.d
    restart: always

  api:
    build: .
    container_name: mdis_crm_api
    env_file:
      - .env.docker
    ports:
      - "8082:8080"
    depends_on:
      - db
    restart: always

volumes:
  pgdata:
